##
## Application
##
APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# APP_PREVIOUS_KEYS=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

##
## Tenancy
##
APP_DOMAIN=app.com
CENTRAL_DOMAIN=app.com
TENANT_DB_PREFIX=tenant_
TENANT_QUEUE_PREFIX=tenant-

##
## Logging
##
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# LOG_DEPRECATIONS_TRACE=false
LOG_LEVEL=debug
# LOG_DAILY_DAYS=14
# LOG_STDERR_FORMATTER=
# LOG_SYSLOG_FACILITY=LOG_USER

## Papertrail (when LOG_STACK includes papertrail)
# PAPERTRAIL_URL=
# PAPERTRAIL_PORT=
# LOG_PAPERTRAIL_HANDLER=SocksSyslogUdpHandler

## Slack (when LOG_STACK includes slack)
# LOG_SLACK_WEBHOOK_URL=
# LOG_SLACK_USERNAME=Laravel
# LOG_SLACK_EMOJI=:boom:

##
## Database
##
DB_CONNECTION=sqlite
# DB_URL=
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=
# DB_SOCKET=
# DB_CHARSET=utf8mb4
# DB_COLLATION=utf8mb4_unicode_ci
# DB_SSLMODE=prefer
# DB_FOREIGN_KEYS=true
# MYSQL_ATTR_SSL_CA=

## SQL Server only
# DB_ENCRYPT=yes
# DB_TRUST_SERVER_CERTIFICATE=false

## Central database (multi-tenancy landlord connection)
CENTRAL_DB_DRIVER=sqlite
CENTRAL_DB_DATABASE=/path/to/database/central.sqlite
# CENTRAL_DB_URL=
# CENTRAL_DB_HOST=127.0.0.1
# CENTRAL_DB_PORT=3306
# CENTRAL_DB_USERNAME=root
# CENTRAL_DB_PASSWORD=

##
## Session
##
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# SESSION_CONNECTION=
# SESSION_TABLE=sessions
# SESSION_STORE=
# SESSION_EXPIRE_ON_CLOSE=false
# SESSION_HTTP_ONLY=true
# SESSION_SECURE_COOKIE=false
# SESSION_SAME_SITE=lax
# SESSION_PARTITIONED_COOKIE=false

##
## Broadcasting
##
BROADCAST_CONNECTION=log

##
## Filesystem
##
FILESYSTEM_DISK=local

##
## Queues
##
QUEUE_CONNECTION=database
# QUEUE_FAILED_DRIVER=database-uuids

## Database queue driver
# DB_QUEUE_CONNECTION=
# DB_QUEUE=default
# DB_QUEUE_TABLE=jobs
# DB_QUEUE_RETRY_AFTER=90

## Redis queue driver
# REDIS_QUEUE_CONNECTION=default
# REDIS_QUEUE=default
# REDIS_QUEUE_RETRY_AFTER=90

## Beanstalkd queue driver
# BEANSTALKD_QUEUE_HOST=localhost
# BEANSTALKD_QUEUE=default
# BEANSTALKD_QUEUE_RETRY_AFTER=90

## SQS queue driver
# SQS_PREFIX=https://sqs.us-east-1.amazonaws.com/your-account-id
# SQS_QUEUE=default
# SQS_SUFFIX=

##
## Cache
##
CACHE_STORE=database
# CACHE_PREFIX=

## Database cache driver
# DB_CACHE_CONNECTION=
# DB_CACHE_TABLE=cache
# DB_CACHE_LOCK_CONNECTION=
# DB_CACHE_LOCK_TABLE=cache_locks

## Redis cache driver
# REDIS_CACHE_CONNECTION=cache
# REDIS_CACHE_LOCK_CONNECTION=default

## DynamoDB cache driver
# DYNAMODB_CACHE_TABLE=cache
# DYNAMODB_ENDPOINT=

##
## Memcached
##
MEMCACHED_HOST=127.0.0.1
# MEMCACHED_PORT=11211
# MEMCACHED_USERNAME=
# MEMCACHED_PASSWORD=
# MEMCACHED_PERSISTENT_ID=

##
## Redis
##
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# REDIS_URL=
# REDIS_USERNAME=
# REDIS_DB=0
# REDIS_CACHE_DB=1
# REDIS_PREFIX=
# REDIS_CLUSTER=redis
# REDIS_PERSISTENT=false
# REDIS_MAX_RETRIES=3
# REDIS_BACKOFF_ALGORITHM=decorrelated_jitter
# REDIS_BACKOFF_BASE=100
# REDIS_BACKOFF_CAP=1000

##
## Mail
##
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# MAIL_URL=
# MAIL_EHLO_DOMAIN=
# MAIL_SENDMAIL_PATH=/usr/sbin/sendmail -bs -i
# MAIL_LOG_CHANNEL=

##
## Authentication
##
# AUTH_GUARD=web
# AUTH_MODEL=App\Models\User
# AUTH_PASSWORD_BROKER=users
# AUTH_PASSWORD_RESET_TOKEN_TABLE=password_reset_tokens
# AUTH_PASSWORD_TIMEOUT=10800

##
## Sanctum
##
# SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1
# SANCTUM_TOKEN_PREFIX=

##
## AWS
##
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
# AWS_URL=
# AWS_ENDPOINT=

##
## Services
##

## Postmark
# POSTMARK_API_KEY=
# POSTMARK_MESSAGE_STREAM_ID=

## Slack
# SLACK_BOT_USER_OAUTH_TOKEN=
# SLACK_BOT_USER_DEFAULT_CHANNEL=

## Resend
# RESEND_API_KEY=

##
## Frontend
##
VITE_APP_NAME="${APP_NAME}"
